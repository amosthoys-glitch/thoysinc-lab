---
// SPDX-License-Identifier: MIT
// Copyright (c) 2026 Thoys Inc.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { url } from '../lib/urls';
import AdSlot from '../components/AdSlot.astro';
import PostMeta from '../components/PostMeta.astro';
import { AUTHOR, LANGS, SITE_TITLE, SOCIAL } from '../consts';
import OgDefault from '../assets/og-default.png';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, lang, tags, draft, translation } = Astro.props;
// 다른 언어판이 있으면 hreflang 과 언어 전환 링크를 붙입니다.
const otherLang = lang === 'ko' ? 'en' : 'ko';
const otherHref = translation ? url('blog/' + translation + '/') : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	inLanguage: LANGS[lang].htmlLang,
	url: pageUrl,
	mainEntityOfPage: pageUrl,
	image: [new URL((heroImage ?? OgDefault).src, Astro.site).toString()],
	keywords: tags?.join(', ') || undefined,
	author: {
		'@type': 'Person',
		name: AUTHOR,
		url: new URL(url('about/'), Astro.site).toString(),
		sameAs: [SOCIAL.linkedin, SOCIAL.github],
	},
	publisher: { '@type': 'Organization', name: 'Thoys Inc', url: 'https://www.thoysinc.com/' },
	isPartOf: { '@type': 'Blog', name: SITE_TITLE, url: Astro.site?.toString() },
};
---

<html lang={LANGS[lang].htmlLang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			lang={lang}
			type="article"
			publishedTime={pubDate}
			modifiedTime={updatedDate}
			jsonLd={jsonLd}
		/>
		{
			otherHref && (
				<>
					<link rel="alternate" hreflang={LANGS[lang].htmlLang} href={new URL(Astro.url.pathname, Astro.site)} />
					<link rel="alternate" hreflang={LANGS[otherLang].htmlLang} href={new URL(otherHref, Astro.site)} />
				</>
			)
		}
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.4em 0;
			}
			.title :global(.meta) {
				justify-content: flex-start;
			}
			.lang-switch {
				margin: 0.6em 0 0;
				font-size: 0.95em;
			}
			.post-footer {
				margin-top: 3em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
				color: rgb(var(--gray));
				font-size: 0.95em;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<PostMeta
							pubDate={pubDate}
							updatedDate={updatedDate}
							lang={lang}
							tags={tags}
							draft={draft}
						/>
						{
							otherHref && (
								<p class="lang-switch">
									<a href={otherHref} hreflang={LANGS[otherLang].htmlLang}>
										{lang === 'ko' ? 'Read in English →' : '한국어로 읽기 →'}
									</a>
								</p>
							)
						}
					</div>
					<slot />
					<AdSlot />
					<div class="post-footer">
						<p>
							{
								lang === 'ko'
									? '이 글이 도움이 되었다면 RSS 로 구독해 두세요. 질문이나 정정할 내용은 이메일로 알려주시면 반영합니다.'
									: 'Found this useful? Subscribe via RSS. Corrections and questions are welcome by email.'
							}
						</p>
						<a href={url('blog')}>← {lang === 'ko' ? '글 목록으로' : 'All posts'}</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
