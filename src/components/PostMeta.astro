---
import FormattedDate from './FormattedDate.astro';
import { LANGS, type Lang } from '../consts';
import { url } from '../lib/urls';

interface Props {
	pubDate: Date;
	updatedDate?: Date;
	lang: Lang;
	tags?: string[];
	draft?: boolean;
}

const { pubDate, updatedDate, lang, tags = [], draft = false } = Astro.props;
---

<div class="meta">
	<span class="lang" data-lang={lang}>{LANGS[lang].short}</span>
	<FormattedDate date={pubDate} />
	{updatedDate && <span class="updated">· 수정 <FormattedDate date={updatedDate} /></span>}
	{draft && <span class="draft">DRAFT</span>}
	{
		tags.length > 0 && (
			<span class="tags">
				{tags.map((tag) => (
					<a href={url(`tags/${tag}/`)}>#{tag}</a>
				))}
			</span>
		)
	}
</div>
<style>
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.lang {
		padding: 0.1em 0.45em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.05em;
	}
	.draft {
		padding: 0.1em 0.45em;
		border-radius: 4px;
		background: #b45309;
		color: white;
		font-size: 0.75em;
		font-weight: 700;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.tags a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.tags a:hover {
		color: rgb(var(--accent));
		text-decoration: underline;
	}
</style>
