---
// SPDX-License-Identifier: MIT
// Copyright (c) 2026 Thoys Inc.
// Imported by every page — global.css is pulled in here.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/og-default.png';
import { SITE_TITLE, type Lang } from '../consts';
import { url } from '../lib/urls';
import { CLIENT_ID, adsEnabled } from '../data/adsense';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	lang?: Lang;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	/** 검색엔진용 구조화 데이터(JSON-LD). 화면에 보이는 내용과 같아야 합니다. */
	jsonLd?: Record<string, unknown>;
}

// 미리보기 사본(github.io)은 운영 주소를 원본으로 가리켜 중복 콘텐츠로 잡히지 않게 합니다.
const isPreview = import.meta.env.PUBLIC_NOINDEX === 'true';
const canonicalURL = isPreview
	? new URL(Astro.url.pathname.replace(new RegExp('^' + import.meta.env.BASE_URL.replace(/\/$/, '')), '') || '/', 'https://blog.thoysinc.com')
	: new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	lang = 'ko',
	type = 'website',
	publishedTime,
	modifiedTime,
	jsonLd,
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
<link rel="icon" href={url("favicon.ico")} />
<link rel="sitemap" href={url("sitemap-index.xml")} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
{
	/* 애드센스. CLIENT_ID 가 비어 있으면 이 스크립트 자체가 나가지 않습니다. */
	adsEnabled && <meta name="google-adsense-account" content={CLIENT_ID} />
}
{
	adsEnabled && (
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${CLIENT_ID}`}
			crossorigin="anonymous"
		/>
	)
}
{import.meta.env.PUBLIC_NOINDEX === "true" && <meta name="robots" content="noindex, nofollow" />}
<!-- Google Analytics: thoysinc.com 주소에서만 켭니다 (로컬 미리보기·GitHub Pages 사본 제외). -->
<script is:inline>
	if (location.hostname === 'thoysinc.com' || location.hostname.endsWith('.thoysinc.com')) {
		var ga = document.createElement('script');
		ga.async = true;
		ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-QT3J6F0WE0';
		document.head.appendChild(ga);
		window.dataLayer = window.dataLayer || [];
		window.gtag = function () { window.dataLayer.push(arguments); };
		window.gtag('js', new Date());
		window.gtag('config', 'G-QT3J6F0WE0');
	}
</script>


<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="naver-site-verification" content="c97dfadb878d6ce52697b24110fe2f43441aa736" />
<meta name="impact-site-verification" value="b256a328-0ff5-42a1-983c-45598fd1f672" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
<meta property="og:site_name" content={SITE_TITLE} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- Structured data -->
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
