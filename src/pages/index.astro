import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostMeta from '../components/PostMeta.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts } from '../lib/posts';
import { url } from '../lib/urls';

const recent = (await getPosts()).slice(0, 5);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			jsonLd={{
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				url: Astro.site?.toString(),
				description: SITE_DESCRIPTION,
				inLanguage: ['ko', 'en'],
				publisher: { '@type': 'Organization', name: 'Thoys Inc', url: 'https://www.thoysinc.com/' },
			}}
		/>
		<style>
			main {
				width: 800px;
				max-width: calc(100% - 2em);
			}
			.focus {
				margin: 1em 0 2.5em 0;
				padding: 1.25em 1.5em;
				border-left: 4px solid rgb(var(--accent));
				background: rgb(var(--gray-light));
				border-radius: 0 8px 8px 0;
			}
			.focus h2 {
				margin: 0 0 0.5em 0;
				font-size: 1.1em;
			}
			.focus ul {
				margin: 0;
				padding-left: 1.2em;
				color: rgb(var(--gray-dark));
			}
			.focus li {
				margin: 0.25em 0;
			}
			.focus .who {
				margin: 0.9em 0 0 0;
				font-size: 0.9em;
				color: rgb(var(--gray));
			}
			.recent ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.recent li {
				padding: 1em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.recent li h3 {
				margin: 0 0 0.3em 0;
				font-size: 1.2em;
			}
			.recent li h3 a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			.recent li h3 a:hover {
				color: rgb(var(--accent));
			}
			.more {
				display: inline-block;
				margin-top: 1.5em;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="focus">
				<h2>여기서 다루는 것</h2>
				<ul>
					<li><b>이번 주 보안</b> — 실제 공격에 쓰이는 취약점과, 관리자가 지금 할 일</li>
					<li><b>Active Directory 홈랩</b> — 도메인 컨트롤러, 그룹 정책, 이중화를 직접 세우고 부순 기록 (<a href={url('blog/adlab-01-design/')}>연재 1회부터</a>)</li>
					<li><b>다지점 리테일 인프라</b> — 매장 네트워크, POS, 서버 운영에서 실제로 겪은 것</li>
					<li><b>Entra ID · Intune</b> — 하이브리드 구성의 함정</li>
					<li><b>PowerShell 자동화</b> — 붙여넣고 바로 돌아가는 스크립트</li>
				</ul>
				<p class="who">글쓴이 소개는 <a href={url('about')}>About</a>에 있습니다.</p>
			</section>

			<section class="recent">
				<h2>최근 글</h2>
				{recent.length === 0 && <p class="empty">첫 글을 준비 중입니다.</p>}
				<ul>
					{
						recent.map((post) => (
							<li>
								<h3>
									<a href={url(`blog/${post.id}/`)}>{post.data.title}</a>
								</h3>
								<PostMeta
									pubDate={post.data.pubDate}
									updatedDate={post.data.updatedDate}
									lang={post.data.lang}
									tags={post.data.tags}
									draft={post.data.draft}
								/>
							</li>
						))
					}
				</ul>
				<a class="more" href={url('blog')}>모든 글 보기 →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
