---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostMeta from '../../components/PostMeta.astro';
import { SITE_DESCRIPTION } from '../../consts';
import { getPosts } from '../../lib/posts';
import { url } from '../../lib/urls';

const posts = await getPosts();
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="Blog" description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 800px;
				max-width: calc(100% - 2em);
			}
			.filters {
				display: flex;
				gap: 0.5em;
				margin-bottom: 2em;
			}
			.filters button {
				padding: 0.4em 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 999px;
				background: white;
				color: rgb(var(--gray-dark));
				font: inherit;
				font-size: 0.9em;
				cursor: pointer;
			}
			.filters button[aria-pressed='true'] {
				border-color: rgb(var(--accent));
				background: rgb(var(--accent));
				color: white;
			}
			ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			li {
				padding: 1.25em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			li[hidden] {
				display: none;
			}
			li h2 {
				margin: 0 0 0.3em 0;
				font-size: 1.4em;
				line-height: 1.3;
			}
			li h2 a {
				color: rgb(var(--black));
				text-decoration: none;
			}
			li h2 a:hover {
				color: rgb(var(--accent));
			}
			li p.excerpt {
				margin: 0.5em 0 0.75em 0;
				color: rgb(var(--gray-dark));
			}
			.empty {
				padding: 2em 0;
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<div class="filters" role="group" aria-label="언어 필터">
				<button type="button" data-filter="all" aria-pressed="true">전체</button>
				<button type="button" data-filter="ko" aria-pressed="false">한국어</button>
				<button type="button" data-filter="en" aria-pressed="false">English</button>
			</div>
			{posts.length === 0 && <p class="empty">아직 발행된 글이 없습니다.</p>}
			<ul>
				{
					posts.map((post) => (
						<li data-lang={post.data.lang}>
							<h2>
								<a href={url(`blog/${post.id}/`)}>{post.data.title}</a>
							</h2>
							<PostMeta
								pubDate={post.data.pubDate}
								updatedDate={post.data.updatedDate}
								lang={post.data.lang}
								tags={post.data.tags}
								draft={post.data.draft}
							/>
							<p class="excerpt">{post.data.description}</p>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
			const items = document.querySelectorAll<HTMLLIElement>('main ul li');

			function apply(filter: string) {
				for (const item of items) {
					item.hidden = filter !== 'all' && item.dataset.lang !== filter;
				}
				for (const button of buttons) {
					button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
				}
				const url = new URL(window.location.href);
				if (filter === 'all') url.searchParams.delete('lang');
				else url.searchParams.set('lang', filter);
				history.replaceState(null, '', url);
			}

			for (const button of buttons) {
				button.addEventListener('click', () => apply(button.dataset.filter!));
			}

			const initial = new URL(window.location.href).searchParams.get('lang');
			if (initial === 'ko' || initial === 'en') apply(initial);
		</script>
	</body>
</html>
